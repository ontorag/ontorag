
OPENROUTER_API_KEY="..."
# Recommended: fast + capable. The tilde is part of the OpenRouter "latest" alias.
# Avoid *:free slugs for real runs (frequently retired; slow shared router stalls
# multi-chunk instance extraction). Point OPENROUTER_BASE_URL at a local Ollama to
# run offline (e.g. http://localhost:11434/v1 with any non-empty API key).
OPENROUTER_MODEL="~deepseek/deepseek-v4-flash-latest"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_NAME="OntoRAG"
OPENROUTER_SITE_URL="https://ontorag.github.io"

# PageIndex (document ingestion) — hosted API at pageindex.ai, only for --engine pageindex
PAGEINDEX_API_KEY="..."

# All OPENROUTER_* values above can also be passed as CLI flags (precedence:
# flag > env > default), e.g.:
#   ontorag --model '~deepseek/deepseek-v4-flash-latest' --api-key sk-... extract-schema ...
